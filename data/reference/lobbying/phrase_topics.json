{
  "version": "phrases-2026-10-01-v1",
  "note": "Phrase searches for the public 'what tech lobbies about' page. A topic counts an issue entry when any of its patterns appears in the entry's description. Patterns are regular expressions and ignore capitalization unless case_sensitive is true. A match means the phrase appears; it does not say what position the filer took. Change the version when patterns change.",
  "topics": [
    {"id": "ai", "label": "Artificial intelligence", "phrases": "\"artificial intelligence\" or \"AI\"",
     "patterns": [{"pattern": "\\bartificial[\\s-]+intelligence\\b"},
                  {"pattern": "(?<![A-Za-z0-9])(?:AI|A\\.I\\.)(?![A-Za-z0-9])", "case_sensitive": true}]},
    {"id": "data_centers", "label": "Data centers", "phrases": "\"data center\" or \"data centers\"",
     "patterns": [{"pattern": "\\bdata[\\s-]?cent(?:er|re)s?\\b"}]},
    {"id": "preemption", "label": "Preemption of state laws", "phrases": "\"preempt\", \"preemption\" or \"moratorium\"",
     "patterns": [{"pattern": "\\bpre-?empt\\w*"}, {"pattern": "\\bmoratorium\\b"}]},
    {"id": "export_controls", "label": "Export controls", "phrases": "\"export control\" or \"export controls\"",
     "patterns": [{"pattern": "\\bexport[\\s-]+controls?\\b"}]},
    {"id": "semiconductors", "label": "Semiconductors and chips", "phrases": "\"semiconductor\", \"chips\" or \"CHIPS Act\"",
     "patterns": [{"pattern": "\\bsemiconductors?\\b"}, {"pattern": "\\bchips?\\b"}]},
    {"id": "energy", "label": "Energy and electricity", "phrases": "\"energy\", \"electricity\" or \"grid\"",
     "patterns": [{"pattern": "\\benergy\\b"}, {"pattern": "\\belectricity\\b"}, {"pattern": "\\bgrid\\b"}]},
    {"id": "privacy", "label": "Privacy", "phrases": "\"privacy\" or \"data protection\"",
     "patterns": [{"pattern": "\\bprivacy\\b"}, {"pattern": "\\bdata protection\\b"}]},
    {"id": "copyright", "label": "Copyright", "phrases": "\"copyright\" or \"intellectual property\"",
     "patterns": [{"pattern": "\\bcopyrights?\\b"}, {"pattern": "\\bintellectual property\\b"}]},
    {"id": "kids", "label": "Children and online safety", "phrases": "\"children\", \"kids\", \"minors\", \"child safety\", \"COPPA\" or \"KOSA\"",
     "patterns": [{"pattern": "\\bchild(?:ren)?(?:'s)?\\b"}, {"pattern": "\\bkids\\b"}, {"pattern": "\\bminors\\b"},
                  {"pattern": "\\b(?:COPPA|KOSA)\\b"}]},
    {"id": "section_230", "label": "Section 230 and content moderation", "phrases": "\"Section 230\", \"content moderation\" or \"intermediary liability\"",
     "patterns": [{"pattern": "\\bsection\\s+230\\b"}, {"pattern": "\\bcontent moderation\\b"},
                  {"pattern": "\\bintermediary liability\\b"}]},
    {"id": "antitrust", "label": "Antitrust and competition", "phrases": "\"antitrust\" or \"competition\"",
     "patterns": [{"pattern": "\\banti-?trust\\b"}, {"pattern": "\\bcompetition\\b"}]},
    {"id": "crypto", "label": "Crypto and digital assets", "phrases": "\"crypto\", \"digital asset\", \"stablecoin\" or \"blockchain\"",
     "patterns": [{"pattern": "\\bcrypto\\w*"}, {"pattern": "\\bdigital assets?\\b"}, {"pattern": "\\bstablecoins?\\b"},
                  {"pattern": "\\bblockchain\\b"}]},
    {"id": "tariffs", "label": "Tariffs", "phrases": "\"tariff\" or \"tariffs\"",
     "patterns": [{"pattern": "\\btariffs?\\b"}]},
    {"id": "immigration", "label": "Immigration and visas", "phrases": "\"immigration\", \"visa\" or \"H-1B\"",
     "patterns": [{"pattern": "\\bimmigration\\b"}, {"pattern": "\\bvisas?\\b"}, {"pattern": "\\bH-?1B\\b"}]},
    {"id": "quantum", "label": "Quantum computing", "phrases": "\"quantum\"",
     "patterns": [{"pattern": "\\bquantum\\b"}]}
  ]
}
